# ──────────────────────────────────────────────────────────────────────────
# Shopify Admin API test tokens — COPY this file to ".env" and fill in values.
# NEVER commit the real .env file. Tokens are secrets.
#
# Create each token in its OWN store:
#   Settings → Apps and sales channels → Develop apps → Create an app
#   → Configure Admin API scopes (read-only):
#       read_products, read_orders, read_customers, read_draft_orders, read_files
#   → Install app → reveal "Admin API access token" (shpat_...)
# ──────────────────────────────────────────────────────────────────────────

# Store A (e.g. testing001)
STORE_A_DOMAIN=testing001-3scoifyo.myshopify.com
STORE_A_TOKEN=

# Store B (the second dev store you created)
STORE_B_DOMAIN=your-second-store.myshopify.com
STORE_B_TOKEN=

# Admin API version to target
SHOPIFY_API_VERSION=2025-01
