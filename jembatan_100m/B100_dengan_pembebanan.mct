*STLDCASE    ; Static Load Cases
; LCNAME, LCTYPE, DESC
   MS   , D , Berat sendiri - baja termodel + pengaku badan + sirip anti selip
   MA   , D , Beban mati tambahan - sandaran 0.5 kN/m tiap sisi (SNI 1725 ps. 7.3)
   TD-BTR, L , Beban lajur D - BTR q = 8.25 kPa (SNI 1725 ps. 8.3.1)
   TD-BGT, L , Beban lajur D - BGT p = 49 kN/m x (1+FBD 0.4) (SNI 1725 ps. 8.3.1)
   TB1  , L , Gaya rem - truk desain SNI 500 kN (SNI 1725 ps. 8.7)
   TB2  , L , Gaya rem - kendaraan khusus CAT 777 (SNI 1725 ps. 8.7)
   TB3  , L , Gaya rem - truk XCMG XT400DT 8x4 GVW 65 t (SNI 1725 ps. 8.7)
   EWS  , W , Angin pada struktur EWs = 4.70 kN/m (SNI 1725 ps. 9.6.1.1)
   EWL  , W , Angin pada kendaraan EWl = 1.46 kN/m (SNI 1725 ps. 9.6.1.2)
   EWV  , W , Angin vertikal ke atas 5.76 kN/m (SNI 1725 ps. 9.6.2)
   EUN  , T , Temperatur seragam dT = +15 C (SNI 1725 ps. 9.3.1 Tabel 18)
   EQX  , E , Gempa memanjang As=0.108 x W permanen - PGA 0.0431g situs SE (SNI 2833)
   EQY  , E , Gempa melintang As=0.108 x W permanen - PGA 0.0431g situs SE (SNI 2833)


