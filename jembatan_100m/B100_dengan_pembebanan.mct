;==========================================================================
; BLOK PEMBEBANAN (hasil perhitungan SNI 1725-2016 / SNI 2833-2016)
;==========================================================================
*UNIT
; FORCE, LENGTH, HEAT, TEMPER
   KN, M, BTU, C

;--------------------------------------------------------------------------
; LOAD CASE (tambahan: TP, EUN-N; lainnya sudah ada di model)
;--------------------------------------------------------------------------
*STLDCASE
; LCNAME, LCTYPE, DESC
   MS     , D, Berat sendiri - baja (selfweight) + plat lantai beton 250 mm
   MA     , D, Beban mati tambahan - topping trotoar 100 mm + sandaran + aspal 50 mm
   TD-BTR , L, Beban lajur D - BTR q = 5.85 kPa (SNI 1725 ps.8.3.1, L=100 m)
   TD-BGT , L, Beban lajur D - BGT p = 49 x (1+FBD 0.30) = 63.7 kN/m
   TP     , L, Beban pejalan kaki 5 kPa pada trotoar (SNI 1725 ps.8.9)
   EWS    , W, Angin pada struktur PD = 2.4 kPa (SNI 1725 ps.9.6.1.1)
   EWL    , W, Angin pada kendaraan EWl = 1.46 kN/m @1.8 m (SNI 1725 ps.9.6.1.2)
   EWV    , W, Angin vertikal 0.96 kPa x 7.6 m ke atas (SNI 1725 ps.9.6.2)
   EUN    , T, Suhu seragam naik dT = +15 C (SNI 1725 Tabel 18)
   EUN-N  , T, Suhu seragam turun dT = -15 C (SNI 1725 Tabel 18)
   EQX    , E, Gempa memanjang statik ekuivalen Csm/R = 0.910 (SNI 2833, Dili)
   EQY    , E, Gempa melintang statik ekuivalen Csm/R = 0.910 (SNI 2833, Dili)

;--------------------------------------------------------------------------
; MS - BERAT SENDIRI : selfweight baja + plat lantai beton 250 mm
;--------------------------------------------------------------------------
*USE-STLD, MS
; *SELFWEIGHT, X, Y, Z, GROUP
*SELFWEIGHT, 0, 0, -1, 

; Plat lantai t=250 mm, gamma beton 24 kN/m3 -> q = 6.00 kN/m2
; w = q x lebar tributari  (stringer tepi b=1.050 m ; stringer dalam b=1.100 m)
*BEAMLOAD
; ELEM_LIST, CMD, TYPE, DIR, bPROJ, [ECCEN], D1, P1, D2, P2, D3, P3, D4, P4, GROUP
; [ECCEN] : bECCEN, ECCDIR, I-END, J-END, bJ-END
; ST-1  y=0.500 m  b=1.050 m  ->  6.300 kN/m
   275to280 282to290, BEAM, UNILOAD, GZ, NO, NO, LZ, 0, 0, NO, 0, -6.3000, 1, -6.3000, 0, 0, 0, 0, 
; ST-2  y=1.600 m  b=1.100 m  ->  6.600 kN/m
   259to264 266to274, BEAM, UNILOAD, GZ, NO, NO, LZ, 0, 0, NO, 0, -6.6000, 1, -6.6000, 0, 0, 0, 0, 
; ST-3  y=2.700 m  b=1.100 m  ->  6.600 kN/m
   243to248 250to258, BEAM, UNILOAD, GZ, NO, NO, LZ, 0, 0, NO, 0, -6.6000, 1, -6.6000, 0, 0, 0, 0, 
; ST-4  y=3.800 m  b=1.100 m  ->  6.600 kN/m
   179to184 186to194, BEAM, UNILOAD, GZ, NO, NO, LZ, 0, 0, NO, 0, -6.6000, 1, -6.6000, 0, 0, 0, 0, 
; ST-5  y=4.900 m  b=1.100 m  ->  6.600 kN/m
   195to200 202to210, BEAM, UNILOAD, GZ, NO, NO, LZ, 0, 0, NO, 0, -6.6000, 1, -6.6000, 0, 0, 0, 0, 
; ST-6  y=6.000 m  b=1.100 m  ->  6.600 kN/m
   211to216 218to226, BEAM, UNILOAD, GZ, NO, NO, LZ, 0, 0, NO, 0, -6.6000, 1, -6.6000, 0, 0, 0, 0, 
; ST-7  y=7.100 m  b=1.050 m  ->  6.300 kN/m
   227to232 234to242, BEAM, UNILOAD, GZ, NO, NO, LZ, 0, 0, NO, 0, -6.3000, 1, -6.3000, 0, 0, 0, 0, 

