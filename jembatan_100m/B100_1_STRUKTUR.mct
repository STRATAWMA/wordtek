;============================================================================
; TUMPUAN - 4 buah POT BEARING
;============================================================================
; node 16 (x=100 m, y=0)    : POT TETAP / FIXED          -> Dx Dy Dz
; node 56 (x=100 m, y=7.6)  : POT PENGARAH MEMANJANG     -> Dx Dz   (bebas arah Y)
; node  1 (x=0,     y=0)    : POT PENGARAH MELINTANG     -> Dy Dz   (bebas arah X)
; node 48 (x=0,     y=7.6)  : POT BEBAS / FREE SLIDING   -> Dz      (bebas X dan Y)
; Semua rotasi bebas (Rx=Ry=Rz=0) sesuai perilaku pot bearing.
*CONSTRAINT
; NODE_LIST, CONST(Dx,Dy,Dz,Rx,Ry,Rz), GROUP
   16, 111000, 
   56, 101000, 
   1, 011000, 
   48, 001000, 

