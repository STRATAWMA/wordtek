; iSEC, TYPE, SNAME, [OFFSET], bSD, bWE, SHAPE                                 ; 1st line - PSC
;       OPT1, OPT2, [JOINT]                                                    ; 2nd line
;       bSHEARCHK, [SCHK], [WT], WIDTH, bSYM, bSIDEHOLE                        ; 3rd line
;       bUSERDEFMESHSIZE, MESHSIZE, bUSERINPSTIFF, [STIFF]                     ; 4th line
